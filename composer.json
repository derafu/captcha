{
    "name": "derafu/captcha",
    "description": "Derafu: Captcha - Captcha providers for the forms of derafu/form",
    "type": "library",
    "homepage": "https://www.derafu.dev/docs/core/captcha",
    "license": "MIT",
    "authors": [
        {
            "name": "Esteban De La Fuente Rubio / Derafu",
            "homepage": "https://www.derafu.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/derafu/captcha/issues",
        "source": "https://github.com/derafu/captcha"
    },
    "autoload": {
        "psr-4": {
            "Derafu\\Captcha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Derafu\\TestsCaptcha\\": "tests/src/"
        }
    },
    "require": {
        "php": "^8.5",
        "derafu/translation": "dev-main",
        "derafu/form": "dev-main",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.4",
        "nikic/php-parser": "^5.9",
        "guzzlehttp/guzzle": "^7.10",
        "symfony/dependency-injection": "^8.1",
        "symfony/config": "^8.1",
        "symfony/yaml": "^8.1",
        "derafu/data-processor": "dev-main",
        "altcha-org/altcha": "^2.3"
    },
    "scripts": {
        "docs": "php tools/phpdocumentor run --config=phpdoc.xml",
        "tests": "XDEBUG_MODE=coverage vendor/bin/phpunit --configuration=phpunit.xml",
        "phpcs-fix": "vendor/bin/php-cs-fixer fix -v --config=php-cs-fixer.php",
        "phpcs": "vendor/bin/php-cs-fixer fix -v --dry-run --diff --config=php-cs-fixer.php",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
        "phpstan-export": "vendor/bin/phpstan analyse --configuration=phpstan.neon --level 9 --generate-baseline"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "nikic/php-parser": "Required by the tests of the messages of the package (Derafu\\Translation\\Lint reads the code).",
        "altcha-org/altcha": "Required by the ALTCHA provider (CAPTCHA_PROVIDER=altcha): it makes and verifies its challenges. The other providers do not need it."
    }
}
